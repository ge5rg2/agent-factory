# ── Google Gemini API Key ──────────────────────────────────────────────────────
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# ── Agent-level Model Config (Dynamic Model Config) ───────────────────────────
# 각 에이전트가 사용할 Gemini 모델을 개별적으로 지정할 수 있습니다.
# 미설정 시 주석에 표시된 기본값이 사용됩니다.
#
# 추천 모델 선택 전략:
#   - 기획/설계처럼 구조적 사고가 필요한 단계   → gemini-2.5-flash (고성능)
#   - 코드 생성처럼 길고 정밀한 출력이 필요한 단계 → gemini-2.5-flash (고성능)
#   - 디자인 스펙처럼 JSON 스키마 생성만 하는 단계 → gemini-2.5-flash-lite (경량)
#   - QC 리뷰처럼 전체 코드를 읽고 추론하는 단계  → gemini-2.5-flash (고성능)

# PM 에이전트 (기획, 파일 구조, 인터페이스 계약 설계)
# Default: gemini-2.5-flash
PM_MODEL=gemini-2.5-flash

# Designer 에이전트 (디자인 스펙, pixel_sprites, ui_components 생성)
# Default: gemini-2.5-flash-lite
DESIGNER_MODEL=gemini-2.5-flash-lite

# Frontend 에이전트 (HTML/CSS/JS 코드 생성)
# Default: gemini-2.5-flash
FE_MODEL=gemini-2.5-flash

# Backend 에이전트 (Python/FastAPI 코드 생성)
# Default: gemini-2.5-flash
BE_MODEL=gemini-2.5-flash

# QC 에이전트 (코드 리뷰, 자동 수정, README 생성)
# Default: gemini-2.5-flash
QC_MODEL=gemini-2.5-flash

# ── Designer 스타일 검색 (Design Searching) ───────────────────────────────────
# Google Search 그라운딩으로 스타일 레퍼런스를 자동 검색합니다.
# false로 설정하면 검색 없이 즉시 디자인 스펙 생성 (빠르지만 덜 정교함)
# Default: true
DESIGN_SEARCH=true

# ── DevOps 배포 플랫폼 (PM 자동 감지 + 수동 오버라이드) ──────────────────────
# PM 에이전트가 project_type을 결정한 뒤 DevOps 에이전트가 플랫폼을 자동 선택합니다:
#   frontend_only          → Vercel  (정적 파일 직접 배포에 최적)
#   fullstack/backend_only → Railway (컨테이너 풀스택 배포에 최적)
#
# ※ 아이디어에 따라 PM이 어떤 project_type을 결정할지 모르므로
#   두 토큰 모두 설정해두는 것을 강력히 권장합니다.
#
# DEPLOY_PLATFORM은 자동 선택을 무시하고 강제 지정하고 싶을 때만 설정하세요:
#   vercel  : Vercel 강제 사용
#   railway : Railway 강제 사용
#   (미설정): PM의 project_type 판단에 따라 자동 선택 (권장)
DEPLOY_PLATFORM=

# Vercel 토큰 — frontend_only 프로젝트 자동 배포 시 사용
# 토큰 발급: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Railway 토큰 — fullstack / backend_only 프로젝트 자동 배포 시 사용
# 토큰 발급: https://railway.app/account/tokens
# Railway CLI 설치: npm install -g @railway/cli
RAILWAY_TOKEN=
